{% extends "base.html.twig" %}

{% block title %}Wedstrijden{% endblock %}

{% block body %}
<div class="dashboard">
    <section class="dashboard-section" style="grid-column: 1 / -1;">
        <h1>Alle Wedstrijden</h1>
        
        {% if wedstrijden %}
            <table>
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Wedstrijdnummer</th>
                        <th>Datum</th>
                        <th>Tijd</th>
                        <th>Team 1</th>
                        <th>Team 2</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    {% for wedstrijd in wedstrijden %}
                        <tr>
                            <td>{{ wedstrijd.sportnaam }}</td>
                            <td>{{ wedstrijd.wedstrijdnummer }}</td>
                            <td>{{ wedstrijd.datum }}</td>
                            <td>{{ wedstrijd.tijd }}</td>
                            <td>{{ wedstrijd.team1 }}</td>
                            <td>{{ wedstrijd.team2 }}</td>
                            <td>
                                {% if wedstrijd.score1 is not null and wedstrijd.score2 is not null %}
                                    {{ wedstrijd.score1 }} - {{ wedstrijd.score2 }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>Geen wedstrijden gevonden.</p>
        {% endif %}
    </section>
</div>
{% endblock %}