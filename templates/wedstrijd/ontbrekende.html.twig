{% extends 'base.html.twig' %}

{% block title %}Weekend Overzicht{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/ontbrekende.css') }}">
{% endblock %}

{% block body %}

<h1>Ontbrekende uitslagen</h1>

<form method="GET" action="{{ path('app_wedstrijd_ontbrekende_uitslagen') }}">

    <label for="start">van:</label>
    <input type="date" id="start" name="start" value="{{ startDatum }}">

    <label for="eind">tot:</label>
    <input type="date" id="eind" name="eind" value="{{ eindDatum }}">

    <button type="submit">Zoeken</button>

</form>

<h2>Weekend Overzicht</h2>
    <table>
        <thead>
            <tr>
                <th>Sport</th>
                <th>Aantal wedstrijden</th>
                <th>Ontbrekende uitslagen</th>
            </tr>
        </thead>
        <tbody>
            {% for item in overzicht %}
                <tr>
                    <td>{{ item.sport }}</td>
                    <td>{{ item.aantal_wedstrijden }}</td>
                    <td>{{ item.aantal_ontbrekend }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

<h2>Wedstrijden met ontbrekende uitslagen</h2>
    <table>
        <thead>
            <tr>
                <th>Sport</th>
                <th>Aantal</th>
                <th>Tijd</th>
                <th>Team 1</th>
                <th>Team 2</th>
            </tr>
        </thead>
        <tbody>
            {% for wedstrijd in wedstrijden %}
                <tr>
                    <td>{{ wedstrijd.sport }}</td>
                    <td>{{ wedstrijd.datum|date('d-m-Y') }}</td>
                    <td>{{ wedstrijd.tijd|date('H:i') }}</td>
                    <td>{{ wedstrijd.team1 }}</td>
                    <td>{{ wedstrijd.team2 }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}