<!DOCTYPE html>
<html>

<head>
    <title>Ontbrekende uitslagen</title>
</head>
<body>

<h1>Ontbrekende uitslagen</h1>

<form method="GET" action="{{ path('app_wedstrijd_ontbrekende_uitslagen') }}">

    <label for="start">van:</label>
    <input type="date" id="start" name="start" value="{{ startDatum }}">

    <label for="eind">tot:</label>
    <input type="date" id="eind" name="eind" value="{{ eindDatum }}">

    <button type="submit">Zoeken</button>

</form>

<table> 
    <thead>
        <tr>
            <th>Sport</th>
            <th>Datum</th>
            <th>Tijd</th>
            <th>Team 1</th>
            <th>Team 2</th>
        </tr>
    </thead>

    <tbody>
        {% for wedstrijd in wedstrijden %}
            <tr>
                <td>{{ wedstrijd.sport }}</td>
                <td>{{ wedstrijd.datum|date('d-m-Y') }}</td>
                <td>{{ wedstrijd.tijd|date('H:i') }}</td>
                <td>{{ wedstrijd.team1 }}</td>
                <td>{{ wedstrijd.team2 }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
</body>


</html>