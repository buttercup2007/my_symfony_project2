{% extends 'base.html.twig' %}

{% block title %}Weekend Overzicht{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/ontbrekende.css') }}">
{% endblock %}

{% block body %}

<main class="missing-results-page">

<a class="home-link" href="{{ path('home') }}">&larr; Terug naar home</a>

<h1>Ontbrekende uitslagen</h1>

<div class="week-navigation">

    <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen', {
        weekOffset: weekOffset - 1
    }) }}">
        &larr; Vorig weekend
    </a>

    <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen', {
        weekOffset: 0
    }) }}">
        Huidig weekend
    </a>

    <span>
        {{ startDatum|date('d-m-Y') }}
        -
        {{ eindDatum|date('d-m-Y') }}
    </span>

    <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen', {
        weekOffset: weekOffset + 1
    }) }}">
        Volgend weekend &rarr;
    </a>

</div>

<h2>Weekend Overzicht</h2>

<div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Sport</th>
                <th>Aantal wedstrijden</th>
                <th>Ontbrekende uitslagen</th>
            </tr>
        </thead>

        <tbody>
            {% for item in overzicht %}
                <tr>
                    <td>{{ item.sport }}</td>
                    <td>{{ item.aantal_wedstrijden }}</td>
                    <td>{{ item.aantal_ontbrekend }}</td>
                </tr>
            {% endfor %}

        </tbody>
        <tfoot>
            <tr class="total-row">
                <th scope="row">Totaal</th>
                <td>{{ totaalWedstrijden }}</td>
                <td>{{ totaalOntbrekend }}</td>
            </tr>
        </tfoot>
    </table>
</div>

<h2>Wedstrijden met ontbrekende uitslagen</h2>

<div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Sport</th>
                <th>Datum</th>
                <th>Tijd</th>
                <th>Team 1</th>
                <th>Team 2</th>
                <th>Score 1</th>
                <th>Score 2</th>
            </tr>
        </thead>

        <tbody>
            {% for wedstrijd in wedstrijden %}
                <tr>
                    <td>{{ wedstrijd.sport }}</td>
                    <td>{{ wedstrijd.datum|date('d-m-Y') }}</td>
                    <td>{{ wedstrijd.tijd|date('H:i') }}</td>
                    <td>{{ wedstrijd.team1 }}</td>
                    <td>{{ wedstrijd.team2 }}</td>
                    <td class="score-cell">{{ wedstrijd.score1|default(0) }}</td>
                    <td class="score-cell">{{ wedstrijd.score2|default(0) }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="total-row">
                <th colspan="6" scope="row">Totaal ontbrekende uitslagen</th>
                <td>{{ totaalOntbrekend }}</td>
            </tr>
        </tfoot>
    </table>
</div>

</main>
{% endblock %}