{% extends 'base.html.twig' %}

{% block title %}Wedstrijd Detail{% endblock %}

{% block body %}

<div class="wedstrijd-detail">

    <a href="{{ path('home') }}">
        &larr; Terug naar weekend
    </a>

    <h1>Wedstrijd</h1>

    <p>{{wedstrijd.sport }}</p>

    <div class="wedstrijd-teams">

        <div class="team">
            <strong>{{wedstrijd.team1 }}</strong>

            {% if wedstrijd.score1 is not null %}
                <span>{{wedstrijd.score1 }}</span>

            {% else %}
                <span>-</span>
            {% endif %}

        </div>

        <div class="vs"> - </div>

        <div class="team">
            {% if wedstrijd.score2 is not null %}
                <span>{{wedstrijd.score2 }}</span>
            {% else %}
                <span>-</span>
            {% endif %}
            <strong>{{wedstrijd.team2 }}</strong>

        </div>

        <div class="wedstrijd-info">

            <p>
                <strong>Datum:</strong> {{wedstrijd.datum|date('d-m-Y') }}
            </p>

            <p> 
                <strong>Tijd:</strong> {{wedstrijd.tijd }}
            </p>

            <p>
                <strong>Locatie:</strong>{{ wedstrijd.compnummer }}
            </p>

            <p>
                <strong>Wedstrijdnummer:</strong> {{ wedstrijd.wedstrijdnummer }}   
            </p>

        </div>
    </div>

{% endblock %}
