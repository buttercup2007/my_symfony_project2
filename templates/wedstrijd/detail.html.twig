{% extends 'base.html.twig' %}

{% block title %}Wedstrijd Detail{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}?v=20260924-4">
{% endblock %}

{% block body %}

<div class="decor-rings" aria-hidden="true">
    <span class="decor-ring decor-ring--top-large"></span>
    <span class="decor-ring decor-ring--top-small"></span>
    <span class="decor-ring decor-ring--bottom-large"></span>
    <span class="decor-ring decor-ring--bottom-small"></span>
</div>

<main class="wedstrijd-detail">
    <header class="detail-header">
        <a class="back-link" href="{{ path('home') }}">
            &larr; Terug naar weekend
        </a>
        <p class="sport-label">{{ wedstrijd.sport }}</p>
        <h1>Wedstrijd</h1>
    </header>

    <section class="match-sheet" aria-label="Wedstrijdresultaat">
        {% set isDecided = wedstrijd.score1 is not null and wedstrijd.score2 is not null %}
        {% set team1Wins = isDecided and wedstrijd.score1 > wedstrijd.score2 %}
        {% set team2Wins = isDecided and wedstrijd.score2 > wedstrijd.score1 %}

        <div class="team team-home{{ team1Wins ? ' team-winner' : '' }}{{ team2Wins ? ' team-loser' : '' }}">
            <span class="team-label">Thuis</span>
            <strong>{{ wedstrijd.team1 }}</strong>
        </div>

        <div class="scoreline-wrap">
            <span class="match-status">{{ isDecided ? 'Eindstand' : 'Nog te spelen' }}</span>
            <div class="scoreline" aria-label="Score">
                <span class="score-pill">
                    <span class="score-value{{ wedstrijd.score1 is null ? ' score-missing' : '' }}">{{ wedstrijd.score1 is not null ? wedstrijd.score1 : '–' }}</span>
                    <span class="score-separator">:</span>
                    <span class="score-value{{ wedstrijd.score2 is null ? ' score-missing' : '' }}">{{ wedstrijd.score2 is not null ? wedstrijd.score2 : '–' }}</span>
                </span>
            </div>
        </div>

        <div class="team team-away{{ team2Wins ? ' team-winner' : '' }}{{ team1Wins ? ' team-loser' : '' }}">
            <span class="team-label">Uit</span>
            <strong>{{ wedstrijd.team2 }}</strong>
        </div>
    </section>

    <section class="wedstrijd-info" aria-label="Wedstrijddetails">
        <div>
            <span>Datum</span>
            <strong>{{ wedstrijd.datum|date('d-m-Y') }}</strong>
        </div>
        <div>
            <span>Aanvang</span>
            <strong>{{ wedstrijd.tijd }}</strong>
        </div>
        <div>
            <span>Competitie</span>
            <strong>{{ wedstrijd.compnummer }}</strong>
        </div>
        <div>
            <span>Wedstrijdnummer</span>
            <strong>{{ wedstrijd.wedstrijdnummer }}</strong>
        </div>
    </section>
</main>

{% endblock %}
