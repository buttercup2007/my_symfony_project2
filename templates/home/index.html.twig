
{% extends 'base.html.twig' %}

{% block title %}Wedstrijden{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}?v=20260928-4">
{% endblock %}

{% block body %}
    <div class="decor-circles" aria-hidden="true">
        <span class="decor-circle decor-circle--top-large"></span>
        <span class="decor-circle decor-circle--top-small"></span>
        <span class="decor-circle decor-circle--bottom-large"></span>
        <span class="decor-circle decor-circle--bottom-small"></span>
    </div>

    <main class="home-page">
        {% set weekendOffset = weekendOffset|default(0) %}

        <header class="home-header">
            <div>
                <h1>Weekend wedstrijden</h1>
                <p class="intro">Bekijk uitslagen, teams en planning per weekend.</p>
            </div>
            <div id="vue-status" aria-live="polite"></div>
        </header>

        <div id="vue-app"></div>
    </main>

    

    {% endblock %}