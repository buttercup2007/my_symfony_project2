{% extends 'base.html.twig' %}

{% block title %}Wedstrijden{% endblock %}

{% block body %}

<div class="container">

    <h1>Wedstrijden</h1>

    <p>
        Weekend:
        {{ startDatum|date('d-m-Y') }}
        t/m
        {{ eindDatum|date('d-m-Y') }}
    </p>

    <div class="summary">
        <div class="card">
            <h2>{{ overzicht|length }}</h2>
            <p>Sporten</p>
        </div>

        <div class="card">
            <h2>
                {% set totaal = 0 %}
                {% for sport in overzicht %}
                    {% set totaal = totaal + sport.aantal_wedstrijden %}
                {% endfor %}
                {{ totaal }}
            </h2>
            <p>Wedstrijden</p>
        </div>

        <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen') }}" class="card">
            <h2>
                {% set ontbrekend = 0 %}
                {% for sport in overzicht %}
                    {% set ontbrekend = ontbrekend + sport.aantal_ontbrekend %}
                {% endfor %}
                {{ ontbrekend }}
            </h2>
            <p>Ontbrekende uitslagen</p>
        </a>
    </div>

    <h2>Wedstrijd overzicht</h2>

    <table>
        <thead>
            <tr>
                <th>Sportsoort</th>
                <th>Aantal wedstrijden</th>
                <th>Aantal ontbrekende uitslagen</th>
            </tr>
        </thead>

        <tbody>
            {% for sport in overzicht %}
                <tr>
                    <td>{{ sport.sport }}</td>
                    <td>{{ sport.aantal_wedstrijden }}</td>
                    <td>{{ sport.aantal_ontbrekend }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</div>

{% endblock %}