<div class="dashboard">

<section class="dashboard-section">

    <div class="section-header">
        <h1>Wedstrijden</h1>
        <span class="section-count">
            {{ wedstrijden|length }}
        </span>
    </div>

    {% if wedstrijden %}

        {# Groepeer wedstrijden per sport #}
        {% set sporten = {} %}

        {% for wedstrijd in wedstrijden %}
            {% set sport = wedstrijd.sportnaam %}

            {% if sporten[sport] is not defined %}
                {% set sporten = sporten|merge({
                    (sport): []
                }) %}
            {% endif %}

            {% set sporten = sporten|merge({
                (sport): sporten[sport]|merge([wedstrijd])
            }) %}
        {% endfor %}

        <div class="sports-list">

            {% for sport, wedstrijdenSport in sporten %}

                <div class="sport-group">
                    <h3>{{ sport }}</h3>

                    {% for wedstrijd in wedstrijdenSport %}

                        <div class="match-row">

                            <div>
                                <strong>
                                    {{ wedstrijd.team1 }}
                                </strong>

                                <span class="vs">vs</span>

                                <strong>
                                    {{ wedstrijd.team2 }}
                                </strong>
                            </div>

                            <div class="match-info">
                                {{ wedstrijd.datum }}
                                &nbsp;
                                {{ wedstrijd.tijd }}
                            </div>

                            <span class="score">
                                {{ wedstrijd.score1 }} - {{ wedstrijd.score2 }}
                            </span>

                        </div>

                    {% endfor %}

                </div>

            {% endfor %}

        </div>

    {% else %}

        <p class="empty-message">
            Geen wedstrijden beschikbaar.
        </p>

    {% endif %}

</section>

<section class="dashboard-section missing-section">

    <div class="section-header">
        <h1>Ontbrekende uitslagen</h1>
        <span class="section-count missing-count">
            {{ ontbrekende|length }}
        </span>
    </div>

    {% if ontbrekende %}

        {# Groepeer wedstrijden per sport #}
        {% set sporten = {} %}

        {% for wedstrijd in ontbrekende %}
            {% set sport = wedstrijd.sportnaam %}

            {% if sporten[sport] is not defined %}
                {% set sporten = sporten|merge({
                    (sport): []
                }) %}
            {% endif %}

            {% set sporten = sporten|merge({
                (sport): sporten[sport]|merge([wedstrijd])
            }) %}
        {% endfor %}


        <div class="missing-sports">

            {% for sport, wedstrijdenSport in sporten %}

                <details class="sport-dropdown">

                    <summary>
                        <span>{{ sport }}</span>
                        <span class="sport-count">
                            {{ wedstrijdenSport|length }}
                        </span>
                    </summary>

                    <div class="sport-matches">

                        {% for wedstrijd in wedstrijdenSport %}

                            <div class="missing-match">

                                <div>
                                    <strong>
                                        {{ wedstrijd.team1 }}
                                    </strong>

                                    <span class="vs">vs</span>

                                    <strong>
                                        {{ wedstrijd.team2 }}
                                    </strong>
                                </div>

                                <div class="match-info">
                                    {{ wedstrijd.datum }}
                                    &nbsp;
                                    {{ wedstrijd.tijd }}
                                </div>

                                <span class="status">
                                    In afwachting
                                </span>

                            </div>

                        {% endfor %}

                    </div>

                </details>

            {% endfor %}

        </div>

    {% else %}

        <p class="empty-message">
            Geen ontbrekende uitslagen.
        </p>

    {% endif %}

</section>

</div>