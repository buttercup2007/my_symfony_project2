{% extends 'base.html.twig' %}

{% block title %}Wedstrijden overzicht{% endblock %}

{% block body %}

<div class="dashboard">

    <section class="dashboard-section">
        <h1>Wedstrijden</h1>

        {% if wedstrijden %}
            <table>
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Wedstrijdnummer</th>
                        <th>Datum</th>
                        <th>Team 1</th>
                        <th>Team 2</th>
                        <th>Score</th>
                    </tr>
                </thead>

                <tbody>
                    {% for wedstrijd in wedstrijden %}
                        <tr>
                            <td>{{ wedstrijd.sportnaam }}</td>
                            <td>{{ wedstrijd.wedstrijdnummer }}</td>
                            <td>{{ wedstrijd.datum }}</td>
                            <td>{{ wedstrijd.team1 }}</td>
                            <td>{{ wedstrijd.team2 }}</td>
                            <td>
                                {{ wedstrijd.score1 }}
                                -
                                {{ wedstrijd.score2 }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>Geen wedstrijden gevonden.</p>
        {% endif %}

    </section>


    <section class="dashboard-section">
        <h1>Ontbrekende uitslagen</h1>

        {% if ontbrekende %}
            <table>
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Wedstrijddag</th>
                        <th>Datum</th>
                        <th>Team 1</th>
                        <th>Team 2</th>
                        <th>Score</th>
                    </tr>
                </thead>

                <tbody>
                    {% for wedstrijd in ontbrekende %}
                        <tr>
                            <td>{{ wedstrijd.sportnaam }}</td>
                            <td>{{ wedstrijd.wedstrijddag }}</td>
                            <td>{{ wedstrijd.datum }}</td>
                            <td>{{ wedstrijd.team1 }}</td>
                            <td>{{ wedstrijd.team2 }}</td>
                            <td>
                                {% if wedstrijd.score1 is null or wedstrijd.score2 is null %}
                                    -
                                {% else %}
                                    {{ wedstrijd.score1 }} - {{ wedstrijd.score2 }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>Geen ontbrekende uitslagen.</p>
        {% endif %}

    </section>

</div>

{% endblock %}