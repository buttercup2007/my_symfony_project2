
{% extends 'base.html.twig' %}

{% block title %}Wedstrijden{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}?v=20260929-2">
{% endblock %}

{% block body %}
    <div class="decor-circles" aria-hidden="true">
        <span class="decor-circle decor-circle--top-large"></span>
        <span class="decor-circle decor-circle--top-small"></span>
        <span class="decor-circle decor-circle--bottom-large"></span>
        <span class="decor-circle decor-circle--bottom-small"></span>
    </div>

    <main class="home-page dashboard-page">

        <header class="home-header">
            <div>
                <p class="eyebrow">Dashboard</p>
                <h1>Weekend wedstrijden</h1>
                <p class="intro">
                    {{ startDatum|date('d-m-Y') }} t/m {{ eindDatum|date('d-m-Y') }}
                </p>
            </div>
        </header>

        <section class="summary" aria-label="Weekend samenvatting">

            <div class="summary-card">
                <span class="card-label">Wedstrijden</span>
                <strong>{{ totaalWedstrijden }}</strong>
            </div>

            <div class="summary-card">
                <span class="card-label">Uitslagen</span>
                <strong>{{ totaalUitslagen }}</strong>
            </div>

            <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen') }}" class="summary-card summary-card-link">
                <span class="card-label">Ontbrekende uitslagen</span>
                <strong>{{ totaalOntbrekend }}</strong>
                <span class="card-action">Bekijk ontbrekende uitslagen &rarr;</span>
            </a>

            <a href="{{ path('app_weekend') }}" class="summary-card summary-card-link">
                <span class="card-label">Sporten</span>
                <strong>{{ overzicht|length }}</strong>
                <span class="card-action">Bekijk weekend &rarr;</span>
            </a>

        </section>

        <section class="content-section">

            <div class="section-heading">
                <div>
                    <p class="eyebrow">Overzicht</p>
                    <h2>Per sport</h2>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Aantal wedstrijden</th>
                            <th>Ontbrekende uitslagen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in overzicht %}
                            <tr>
                                <td class="strong-cell">{{ item.sport }}</td>
                                <td>{{ item.aantal_wedstrijden }}</td>
                                <td>{{ item.aantal_ontbrekend }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="empty">Geen wedstrijden gevonden voor dit weekend.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </section>
    </main>

    

    {% endblock %}