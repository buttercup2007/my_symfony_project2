{% extends 'base.html.twig' %}

{% block title %}Wedstrijden{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
    <div id="vue-app"></div>

    <main class="home-page">
        {% set weekendOffset = weekendOffset|default(0) %}

        <header class="home-header">
            <div>
                <h1>Weekend wedstrijden</h1>
                <p class="intro">Bekijk uitslagen, teams en planning per weekend.</p>
            </div>
            <div id="vue-status" aria-live="polite"></div>
        </header>

        <nav class="weekend-navigation" aria-label="Weekend navigatie">
            <a class="weekend-arrow" href="{{ path('home', { weekend: weekendOffset - 1, sport: selectedSport|default('Alle'), date: selectedDate|default('Alle') }) }}" aria-label="Vorig weekend">
                <span aria-hidden="true">&larr;</span> Vorig weekend
            </a>

            <p class="weekend-date">
                {{ startDatum|date('d-m-Y') }} <span>t/m</span> {{ eindDatum|date('d-m-Y') }}
            </p>

            <a class="weekend-arrow" href="{{ path('home', { weekend: weekendOffset + 1, sport: selectedSport|default('Alle'), date: selectedDate|default('Alle') }) }}" aria-label="Volgend weekend">
                Volgend weekend <span aria-hidden="true">&rarr;</span>
            </a>
        </nav>

        <form method="get" class="sport-filter-form">
            <input type="hidden" name="weekend" value="{{ weekendOffset }}">

            <div class="filter-field">
                <label for="home-sport-filter">Sport</label>
                <select id="home-sport-filter" name="sport" onchange="this.form.submit()">
                    <option value="Alle" {% if selectedSport|default('Alle') == 'Alle' %}selected{% endif %}>Alle sporten</option>
                    {% for sport in sportOptions %}
                        <option value="{{ sport }}" {% if selectedSport|default('Alle') == sport %}selected{% endif %}>{{ sport }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-field">
                <label for="home-date-filter">Datum</label>
                <select id="home-date-filter" name="date" onchange="this.form.submit()">
                    <option value="Alle" {% if selectedDate|default('Alle') == 'Alle' %}selected{% endif %}>Alle dagen</option>
                    {% for dateOption in dateOptions|default([]) %}
                        <option value="{{ dateOption }}" {% if selectedDate|default('Alle') == dateOption %}selected{% endif %}>{{ dateOption|date('d-m-Y') }}</option>
                    {% endfor %}
                </select>
            </div>
        </form>

        <section class="summary" aria-label="Weekend samenvatting">
            <div class="summary-card">
                <span class="card-label">Sporten</span>
                <strong>{{ overzicht|length }}</strong>
            </div>

            <div class="summary-card">
                <span class="card-label">Totaal wedstrijden</span>
                <strong>
                    {% set totaalWedstrijden = 0 %}
                    {% for sport in overzicht %}
                        {% set totaalWedstrijden = totaalWedstrijden + sport.aantal_wedstrijden %}
                    {% endfor %}
                    {{ totaalWedstrijden }}
                </strong>
            </div>

            <a href="{{ path('app_weekend', { weekend: weekendOffset, sport: selectedSport|default('Alle'), date: selectedDate|default('Alle') }) }}" class="summary-card summary-card-link">
                <span class="card-label">Wedstrijden</span>
                <strong>
                    {{ totaalWedstrijden }}
                </strong>
                <span class="card-action">Bekijk weekend overzicht &rarr;</span>
            </a>

            <a href="{{ path('app_wedstrijd_ontbrekende_uitslagen') }}" class="summary-card summary-card-link">
                <span class="card-label">Ontbrekende uitslagen</span>
                <strong>
                    {% set ontbrekend = 0 %}
                    {% for sport in overzicht %}
                        {% set ontbrekend = ontbrekend + sport.aantal_ontbrekend %}
                    {% endfor %}
                    {{ ontbrekend }}
                </strong>
                <span class="card-action">Bekijk ontbrekende uitslagen &rarr;</span>
            </a>
        </section>

        <section class="content-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Overzicht</p>
                    <h2>Per sport</h2>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Sportsoort</th>
                            <th>Aantal wedstrijden</th>
                            <th>Ontbrekende uitslagen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sport in overzicht %}
                            <tr>
                                <td class="strong-cell">{{ sport.sport }}</td>
                                <td>{{ sport.aantal_wedstrijden }}</td>
                                <td>{{ sport.aantal_ontbrekend }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="empty">Geen wedstrijden gevonden voor dit weekend.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="content-section scores-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Uitslagen</p>
                    <h2>Wedstrijden met scores</h2>
                </div>
                <span class="live-label">Scores beschikbaar</span>
            </div>

            {% set totaalWedstrijdenLijst = 0 %}
            {% for wedstrijd in wedstrijden %}
                {% if wedstrijd.datum >= startDatum|date('Y-m-d') and wedstrijd.datum <= eindDatum|date('Y-m-d') %}
                    {% set totaalWedstrijdenLijst = totaalWedstrijdenLijst + 1 %}
                {% endif %}
            {% endfor %}
            <p class="count-label">Aantal wedstrijden: <strong>{{ totaalWedstrijdenLijst }}</strong></p>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Datum</th><th>Tijd</th><th>Sport</th><th>Team 1</th><th>Team 2</th><th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set aantalWedstrijden = 0 %}
                        {% for wedstrijd in wedstrijden %}
                            {% if wedstrijd.datum >= startDatum|date('Y-m-d') and wedstrijd.datum <= eindDatum|date('Y-m-d') %}
                                {% set aantalWedstrijden = aantalWedstrijden + 1 %}
                                <tr>
                                    <td>{{ wedstrijd.datum|date('d-m-Y') }}</td>
                                    <td>{{ wedstrijd.tijd|default('-') }}</td>
                                    <td>{{ wedstrijd.sport|default('-') }}</td>
                                    <td>{{ wedstrijd.team1|default('-') }}</td>
                                    <td>{{ wedstrijd.team2|default('-') }}</td>
                                    <td class="score-cell">{{ wedstrijd.score1|default(0) }} - {{ wedstrijd.score2|default(0) }}</td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                        {% if aantalWedstrijden == 0 %}
                            <tr><td colspan="6" class="empty">Geen wedstrijden gevonden voor dit weekend.</td></tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    {% endblock %}