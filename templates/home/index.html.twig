{% extends 'base.html.twig' %}

{% block title %}Wedstrijden{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/wedstrijden.css') }}">
{% endblock %}

{% block body %}

    <h1>Wedstrijden</h1>

    <div class="weekend-navigatie">
        <button id="vorige-weekend" type="button">←</button>

        <span id="weekend-datum"></span>

        <button id="volgende-weekend" type="button">→</button>
    </div>

    <div class="wedstrijd-overzicht">

        <div class="wedstrijden">

            <h2>Wedstrijden</h2>

            <p class="wedstrijd-aantal">
                Aantal wedstrijden:
                <strong id="aantal-wedstrijden">0</strong>
            </p>

            <table>
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Tijd</th>
                        <th>Sport</th>
                        <th>Team 1</th>
                        <th>Team 2</th>
                    </tr>
                </thead>

                <tbody id="wedstrijd-table-body">
                </tbody>
            </table>

            <h2>Stand</h2>

        <table>
        <thead>
        <tr>
            <th>Team</th>
            <th>Wedstrijden</th>
            <th>Gewonnen</th>
            <th>Gelijk</th>
            <th>Verloren</th>
            <th>Punten</th>
        </tr>
       </thead>

     <tbody>
        {% for team in teamPunten %}
            <tr>
                <td>{{ team.team }}</td>
                <td>{{ team.wedstrijden }}</td>
                <td>{{ team.gewonnen }}</td>
                <td>{{ team.gelijk }}</td>
                <td>{{ team.verloren }}</td>
                <td>{{ team.punten }}</td>
            </tr>
        {% endfor %}
     </tbody>
     </table>

        </div>

        <div class="ontbrekende-uitslagen">

            <h2>Ontbrekende uitslagen</h2>

            <p class="wedstrijd-aantal">
                Totaal ontbrekend:
                <strong id="totaal-ontbrekend">0</strong>
            </p>

            <table>
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Aantal</th>
                    </tr>
                </thead>

                <tbody id="ontbrekende-uitslagen-body">
                </tbody>
            </table>

        </div>

    </div>

    <script>

        let wedstrijden = [];
        let ontbrekendeUitslagen = [];

        // Tijdelijk een datum waarvan we weten dat er wedstrijden zijn
        let huidigeDatum = new Date('2026-06-13');


        function toonDatum()
        {
            const zaterdag = new Date(huidigeDatum);
            const zondag = new Date(huidigeDatum);

            zondag.setDate(zondag.getDate() + 1);

            document.getElementById('weekend-datum').textContent =
                `${zaterdag.toLocaleDateString('nl-NL')} - ${zondag.toLocaleDateString('nl-NL')}`;
        }


        function toonWedstrijden()
        {
            const tabel =
                document.getElementById('wedstrijd-table-body');

            if (!tabel) {
                return;
            }

            tabel.innerHTML = '';

            const zaterdag = new Date(huidigeDatum);
            const zondag = new Date(huidigeDatum);

            zondag.setDate(zondag.getDate() + 1);


            const wedstrijdenWeekend = wedstrijden.filter(wedstrijd => {

                const datum = new Date(wedstrijd.datum);

                return datum.toDateString() === zaterdag.toDateString()
                    || datum.toDateString() === zondag.toDateString();

            });


            document.getElementById('aantal-wedstrijden').textContent =
                wedstrijdenWeekend.length;


            if (wedstrijdenWeekend.length === 0) {

                tabel.innerHTML = `
                    <tr>
                        <td colspan="5">
                            Geen wedstrijden dit weekend.
                        </td>
                    </tr>
                `;

                toonDatum();

                return;
            }


            wedstrijdenWeekend.forEach(wedstrijd => {

                const rij = document.createElement('tr');

                rij.innerHTML = `
                 <td>
                     ${new Date(wedstrijd.datum)
                     .toLocaleDateString('nl-NL')}
                 </td>

                 <td>
                     ${wedstrijd.tijd || ''}
                 </td>

                 <td>
                     ${wedstrijd.sportsoort || ''}
                 </td>

                 <td>
                     ${wedstrijd.team1 || '-'}
                 </td>

                 <td>
                     ${wedstrijd.team2 || '-'}
                 </td>
                `;

                tabel.appendChild(rij);
            });


            toonDatum();
        }


        function toonOntbrekendeUitslagen()
        {
            const tabel =
                document.getElementById(
                    'ontbrekende-uitslagen-body'
                );

            if (!tabel) {
                return;
            }

            tabel.innerHTML = '';

            let totaal = 0;


            ontbrekendeUitslagen.forEach(item => {

                const aantal = Number(item.aantal);

                totaal += aantal;


                const rij = document.createElement('tr');

                rij.innerHTML = `
                    <td>${item.sport}</td>
                    <td>${aantal}</td>
                `;

                tabel.appendChild(rij);
            });


            document.getElementById('totaal-ontbrekend').textContent =
                totaal;


            if (ontbrekendeUitslagen.length === 0) {

                tabel.innerHTML = `
                    <tr>
                        <td colspan="2">
                            Geen ontbrekende uitslagen.
                        </td>
                    </tr>
                `;
            }
        }


        fetch('/api/wedstrijden')

            .then(response => {

                if (!response.ok) {
                    throw new Error('Fout bij API-aanvraag');
                }

                return response.json();

            })

            .then(data => {

                wedstrijden = data.wedstrijden || [];

                ontbrekendeUitslagen =
                    data.ontbrekendeUitslagen || [];

                toonWedstrijden();

                toonOntbrekendeUitslagen();

            })

            .catch(error => {

                console.error(
                    'Fout bij het laden van gegevens:',
                    error
                );

            });


        document
            .getElementById('vorige-weekend')
            .addEventListener('click', () => {

                huidigeDatum.setDate(
                    huidigeDatum.getDate() - 7
                );

                toonWedstrijden();
            });


        document
            .getElementById('volgende-weekend')
            .addEventListener('click', () => {

                huidigeDatum.setDate(
                    huidigeDatum.getDate() + 7
                );

                toonWedstrijden();
            });

    </script>

{% endblock %}

