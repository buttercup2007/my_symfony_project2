{% extends 'base.html.twig' %}

{% block title %}Vue Page{% endblock %}

{% block body %}
    <div id="app"></div>

    <script type="module">
        import { createApp } from 'https://cdn.jsdelivr.net/npm/vue@3/dist/vue.esm-browser.js';

        createApp({
            data() {
                return {
                    appName: {{ appName|json_encode|raw }},
                    features: {{ features|json_encode|raw }}
                };
            },
            template: `
                <main style="font-family: Arial, sans-serif; max-width: 720px; margin: 4rem auto; padding: 2rem; border-radius: 12px; background: #f7f7fb; box-shadow: 0 8px 30px rgba(0,0,0,0.08);">
                    <h1 style="margin-bottom: 0.5rem; color: #2d3748;" v-text="appName"></h1>
                    <p style="color: #4a5568; margin-bottom: 1.5rem;">A small Vue page rendered from Symfony.</p>
                    <ul style="padding-left: 1.2rem; color: #2d3748; line-height: 1.8;">
                        <li v-for="feature in features" :key="feature" v-text="feature"></li>
                    </ul>
                </main>
            `
        }).mount('#app');
    </script>
{% endblock %}
