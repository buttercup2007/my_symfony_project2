{% extends 'base.html.twig' %}

{% block title %}Wedstrijden overzicht{% endblock %}

{% block body %}

<div class="dashboard">

    {# LINKERKANT - WEDSTRIJDEN (MET UITSLAG) #}
    <section class="dashboard-section">
        <div class="section-header">
            <h1>Wedstrijden</h1>
            <span class="section-count">{{ wedstrijden|length }}</span>
        </div>

        {% if wedstrijden %}
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Wedstrijd</th>
                            <th>Datum</th>
                            <th>Tijd</th>
                            <th>Teams</th>
                            <th>Score</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for wedstrijd in wedstrijden %}
                            <tr>
                                <td>{{ wedstrijd.sportnaam }}</td>

                                <td>
                                    {{ wedstrijd.wedstrijdnummer }}
                                </td>

                                <td>
                                    {{ wedstrijd.datum }}
                                </td>

                                <td>
                                    {{ wedstrijd.tijd }}
                                </td>

                                <td>
                                    {{ wedstrijd.team1 }}
                                    <br>
                                    <span class="vs">vs</span>
                                    <br>
                                    {{ wedstrijd.team2 }}
                                </td>

                                <td>
                                    <strong class="score">
                                        {{ wedstrijd.score1 }} - {{ wedstrijd.score2 }}
                                    </strong>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        {% else %}
            <p class="empty-message">
                Geen wedstrijden met uitslagen gevonden.
            </p>
        {% endif %}

    </section>


    {# RECHTERKANT - ONTBREKENDE UITSLAGEN #}
    <section class="dashboard-section missing-section">

        <div class="section-header">
            <h1>Ontbrekende iets</h1>
            <span class="section-count missing-count">
                {{ ontbrekende|length }}
            </span>
        </div>

        {% if ontbrekende %}
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Wedstrijd</th>
                            <th>Datum</th>
                            <th>Tijd</th>
                            <th>Teams</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for wedstrijd in ontbrekende %}
                            <tr>
                                <td>{{ wedstrijd.sportnaam }}</td>

                                <td>
                                    {{ wedstrijd.wedstrijdnummer }}
                                </td>

                                <td>
                                    {{ wedstrijd.datum }}
                                </td>

                                <td>
                                    {{ wedstrijd.tijd }}
                                </td>

                                <td>
                                    {{ wedstrijd.team1 }}
                                    <br>
                                    <span class="vs">vs</span>
                                    <br>
                                    {{ wedstrijd.team2 }}
                                </td>

                                <td>
                                    <span class="status">
                                        In afwachting
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        {% else %}
            <p class="empty-message">
                Geen ontbrekende uitslagen.
            </p>
        {% endif %}

    </section>

</div>

{% endblock %}


